{
  "name": "tablero-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "MCP server that lets Claude read and update the tablero boards in Firestore",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "pretest": "node scripts/sync-rules.mjs",
    "test": "firebase emulators:exec --only auth,firestore --project demo-tablero-mcp \"vitest run --no-file-parallelism\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "firebase": "^13.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "firebase-admin": "^14.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tablero-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "kanban",
    "firestore"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielitomoros03/moros-mcp.git",
    "directory": "tablero-mcp"
  },
  "homepage": "https://github.com/danielitomoros03/moros-mcp/tree/main/tablero-mcp#readme",
  "author": "Daniel Moros"
}
